{
	"name": "StreamForge Dev",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},
	"remoteUser": "root",
	"mounts": [
		"source=streamforge-dev-config,target=/config,type=volume",
		"source=streamforge-dev-working,target=/working,type=volume"
	],
	"postCreateCommand": ["sh", ".devcontainer/post-create.sh"],
	"waitFor": "postCreateCommand"
}
