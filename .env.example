# Service configuration. Fill in values for the services you use.
DISP_URL=
DISP_USER=
DISP_PASS=
DISP_M3U_URL=
EMBY_HOST=
EMBY_API_KEY=
TMDB_API_KEY=

# Shared settings
STREAMFORGE_TIMEOUT=30s
STREAMFORGE_VERIFY_TLS=true
STREAMFORGE_USER_AGENT="VLC/3.0.20 LibVLC/3.0.20"
STREAMFORGE_CONFIRM=true
STREAMFORGE_START_CHANNEL=1
STREAMFORGE_NORMALIZER=

# Media settings
STREAMFORGE_FFMPEG=/usr/local/bin/ffmpeg
STREAMFORGE_FFPROBE=/usr/local/bin/ffprobe
STREAMFORGE_PLAYBACK_PARENT=
STREAMFORGE_EXCLUDE=
STREAMFORGE_CODEC=keep
STREAMFORGE_CONTAINER=keep
STREAMFORGE_QUALITY=balanced
STREAMFORGE_HARDWARE=auto
STREAMFORGE_JOBS=
